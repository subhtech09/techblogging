---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for post in site.posts -%}
  {%- assign search_topic_key = post.category | default: post.categories.first -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "topic": {{ site.data.topics[search_topic_key].name | default: search_topic_key | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | truncatewords: 600, "" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
